# =============================================================================
# GLOBAL MVP — ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================================
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` — it is already listed in .gitignore.
# NEVER put real secrets, keys or passwords in THIS file.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Used by prisma/schema.prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Direct (non-pooled) connection, used by `prisma migrate`.
# Required: prisma/schema.prisma declares `directUrl = env("DIRECT_URL")`, so
# migrations fail to connect without it. On Supabase this is the connection
# string on port 5432 rather than the pooler on 6543.
DIRECT_URL=


# -----------------------------------------------------------------------------
# AUTHENTICATION — NextAuth (required)
# -----------------------------------------------------------------------------
# Secret used to sign/encrypt JWT session tokens.
# REQUIRED in production — NextAuth will fail to start without it.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL of the deployment. Required in production.
# Also used as `metadataBase` in app/layout.tsx.
# Local example: http://localhost:3000
NEXTAUTH_URL=


# -----------------------------------------------------------------------------
# FILE STORAGE — AWS S3
# -----------------------------------------------------------------------------
# Used by lib/aws-config.ts, lib/s3.ts and app/api/upload/presigned/route.ts.
# Required only if the file upload feature is enabled.
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=
AWS_REGION=

# Credentials for the S3 client. On Vercel these must be set explicitly,
# since the default AWS credential chain has no instance role to fall back on.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# -----------------------------------------------------------------------------
# PDF GENERATION — Abacus AI
# -----------------------------------------------------------------------------
# Used by app/api/generate-pdf/route.ts and app/api/generate-pdf/status/route.ts.
# NOTE: this is a legacy third-party dependency inherited from the Abacus build.
# Invoice PDF generation will not work without it. Planned for replacement.
ABACUSAI_API_KEY=


# -----------------------------------------------------------------------------
# SEED SCRIPT (local development only)
# -----------------------------------------------------------------------------
# Used by scripts/seed.ts. The seed aborts with an error if these are unset.
# Never point these at a production database.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=


# -----------------------------------------------------------------------------
# EMAIL — Resend (password reset)
# -----------------------------------------------------------------------------
# Server-only. Without these the reset endpoint still answers normally, but no
# email is sent — the failure is logged rather than shown, so the response
# cannot be used to probe configuration.
RESEND_API_KEY=
# Verified sender, e.g. "CorpControl <no-reply@corpcontrol.net>"
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
# Address allowed into /admin. Server-only: the check reads the user row from
# the database and compares it to this value, so nothing the browser sends can
# grant access. Leave blank and there is no admin panel at all — the guard
# fails closed rather than open.
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# SUBSCRIPTIONS — Polar
# -----------------------------------------------------------------------------
# Server-only. None of these is prefixed NEXT_PUBLIC_, so no token or price id
# is ever sent to the browser and a client cannot name a price.
#
# Leave every value blank until the Polar products exist. The application
# treats unconfigured billing as unavailable rather than guessing.

# API token from the Polar dashboard.
POLAR_ACCESS_TOKEN=

# Signing secret for the webhook endpoint. Deliveries whose signature does not
# verify are rejected.
POLAR_WEBHOOK_SECRET=

# Which Polar environment to talk to: sandbox | production.
# Preview deployments should stay on sandbox so test purchases never reach the
# production subscription data.
POLAR_SERVER=sandbox

# Price ids, one per plan and billing interval. Checkout resolves these from
# the plan name server-side; the client never supplies a price id.
POLAR_PRO_PRICE_MONTHLY=
POLAR_PRO_PRICE_YEARLY=
POLAR_BUSINESS_PRICE_MONTHLY=
POLAR_BUSINESS_PRICE_YEARLY=


# -----------------------------------------------------------------------------
# BUILD CONFIGURATION (optional)
# -----------------------------------------------------------------------------
# Read by next.config.js. Leave both unset for a normal Vercel deployment.
# NEXT_OUTPUT_MODE=
# NEXT_DIST_DIR=
