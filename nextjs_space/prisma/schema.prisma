generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  hashedPassword String?
  /// Whether the account may sign in. A deactivated account is refused at login
  /// and loses API access, but the row is kept so its history and audit trail
  /// survive. Defaults true, so every existing user stays enabled.
  isActive       Boolean         @default(true)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // --- Personal preferences ----------------------------------------------
  // These follow the person, not the company: someone who reads dates as
  // 25.08.2026 wants that in every workspace they belong to, and a sidebar
  // width preference is a habit rather than a property of a business.
  theme            String  @default("system")
  language         String  @default("en")
  dateFormat       String?
  numberFormat     String?
  firstDayOfWeek   Int?
  sidebarCollapsed Boolean @default(false)

  companyMembers CompanyMember[]
  accounts       Account[]
  sessions       Session[]
  createdEvents  Event[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                  String              @id @default(cuid())
  name                String
  country             String              @default("US")
  defaultCurrency     String              @default("USD")
  timezone            String              @default("America/New_York")
  locale              String              @default("en-US")
  businessType        String?
  address             String?
  city                String?
  state               String?
  postalCode          String?
  phone               String?
  email               String?
  website             String?
  taxNumber           String?
  taxOffice           String?
  legalName           String?
  logoUrl             String?

  // --- Branding -------------------------------------------------------------
  // Hex colours such as "#7C3AED". Null means "use the product default", so
  // existing companies keep today's appearance with no backfill required.
  primaryColor        String?
  secondaryColor      String?
  accentColor         String?
  industry            String?

  // --- Invoice settings -----------------------------------------------------
  // invoiceNextNumber is the next number to hand out. It is allocated with an
  // atomic UPDATE ... RETURNING so two concurrent invoices cannot claim the
  // same value; @@unique([companyId, invoiceNumber]) on Invoice stays as the
  // backstop. Backfilled from existing invoice numbers by the migration.
  invoicePrefix       String              @default("INV-")
  invoiceNextNumber   Int                 @default(1)
  // Payment terms in days. 0 means "due on receipt", which covers the
  // 7/15/30/60/custom options without introducing an enum.
  defaultPaymentTerms Int                 @default(30)
  // Same precision as InvoiceItem.taxRate so a default round-trips exactly.
  defaultTaxRate      Decimal             @default(0) @db.Decimal(7, 4)
  invoiceNotes        String?
  paymentInstructions String?
  invoiceFooter       String?
  invoiceShowLogo     Boolean             @default(true)
  invoiceShowTax      Boolean             @default(true)
  invoiceTemplate     String              @default("classic")

  // --- Payment settings -----------------------------------------------------
  defaultPaymentMethod     String?
  bankTransferInstructions String?

  /// Automatic, polite payment reminders to customers for overdue invoices
  /// (sent by the daily cron). Off by default: nothing is emailed to a
  /// customer until the business switches it on.
  paymentRemindersEnabled  Boolean @default(false)

  // --- Admin-granted plan ---------------------------------------------------
  // A plan an administrator gives a company without a Polar purchase (founder,
  // beta, support). Deliberately NOT written into Subscription: the Polar
  // webhook owns that table and would overwrite it. Resolution order lives in
  // lib/billing/limits.ts — a real Polar subscription always wins over a grant.
  grantedPlan         String?             // 'pro' | 'business' | null
  grantedPlanUntil    DateTime?           // null = no expiry
  grantedPlanReason   String?             // e.g. "founder", "beta", "support"

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  members             CompanyMember[]
  events              Event[]
  customers           Customer[]
  vendors             Vendor[]
  invoices            Invoice[]
  payments            Payment[]
  incomeTransactions  IncomeTransaction[]
  expenseTransactions ExpenseTransaction[]
  categories          Category[]
  attachments         Attachment[]
  /// At most one paid subscription per company. Absence means the Free plan.
  subscription        Subscription?
  bankAccounts        BankAccount[]
  bankTransactions    BankTransaction[]
  chequeInstruments   ChequeInstrument[]
  quotes              Quote[]
  recurringInvoices   RecurringInvoice[]

  /// Quote numbering. A null prefix means "TKL-" for Turkish companies and
  /// "QUO-" otherwise, decided when the quote is numbered.
  quotePrefix         String?
  quoteNextNumber     Int                 @default(1)
  accountantInvites   AccountantInvite[]
  /// "finance" | "stock" | "both" — which part of the product the company uses.
  usageMode           String              @default("finance")
  stockSettings       StockSettings?
  stockStaff          StockStaff[]
  stockCategories     StockCategory[]
  stockProducts       StockProduct[]
  stockMovements      StockMovement[]
  stockCounts         StockCount[]
  stockResets         StockReset[]
  stockTelegramChats  StockTelegramChat[]
  stockTelegramCodes  StockTelegramCode[]
  stockBackups        StockBackup[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      String   @default("owner")

  // --- Company-scoped preferences ------------------------------------------
  // Kept here rather than on User because they only mean anything inside one
  // company's context: which widgets belong on *this* company's dashboard, and
  // which of *this* company's events should notify this member. The existing
  // @@unique([userId, companyId]) already makes this row the natural home for
  // per-membership state, so no new table is needed.
  dashboardPreferences    Json?
  notificationPreferences Json?

  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Customer {
  id              String              @id @default(cuid())
  companyId       String
  name            String
  companyName     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  taxId           String?
  /// Vergi dairesi. Shown on the invoice next to the tax number.
  taxOffice       String?
  /// Language for documents and emails sent to this customer ('tr' | 'en').
  /// Null means "decide from the country".
  language        String?
  defaultCurrency String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  quotes          Quote[]
  recurringInvoices RecurringInvoice[]
  incomeTransactions IncomeTransaction[]
  events          Event[]
  chequeInstruments ChequeInstrument[]

  @@index([companyId])
}

model Vendor {
  id              String              @id @default(cuid())
  companyId       String
  name            String
  companyName     String?
  email           String?
  phone           String?
  address         String?
  country         String?
  taxId           String?
  /// Vergi dairesi.
  taxOffice       String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenseTransactions ExpenseTransaction[]
  chequeInstruments ChequeInstrument[]
  /// KolayStok: every address a purchase-order email goes to.
  orderEmails     String[]            @default([])
  stockCategories StockCategory[]
  stockProducts   StockProduct[]

  @@index([companyId])
}

model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  customerId    String
  invoiceNumber String
  status        String        @default("DRAFT")
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  currency      String        @default("USD")
  subtotal      Decimal       @default(0) @db.Decimal(15, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(15, 2)
  discountTotal Decimal       @default(0) @db.Decimal(15, 2)
  total         Decimal       @default(0) @db.Decimal(15, 2)
  amountPaid    Decimal       @default(0) @db.Decimal(15, 2)
  notes         String?
  /// Last time the invoice was emailed to the customer from the app.
  sentAt                 DateTime?
  /// Claim stamps for the automatic payment reminders, so each one is sent at
  /// most once per invoice even if the cron runs twice.
  overdueReminderSentAt  DateTime?
  followUpReminderSentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  /// The quote this invoice was created from, if any.
  sourceQuote   Quote?        @relation("QuoteConvertedInvoice")
  /// The recurring template that produced it, if any.
  recurringInvoiceId String?
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  payments      Payment[]
  events        Event[]
  /// Bank lines reconciled against this invoice. Prisma-side only — the column
  /// lives on BankTransaction, so no existing table gains anything.
  bankTransactions BankTransaction[]
  /// Cheques and notes offered in settlement of this invoice. Prisma-side only.
  chequeInstruments ChequeInstrument[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  /// The calendar's month query: one company's invoices inside a due-date
  /// window. The single-column [dueDate] index cannot serve it without also
  /// scanning other companies' rows.
  @@index([companyId, dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(15, 4)
  unitPrice   Decimal @default(0) @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)
  taxLabel    String  @default("VAT")
  amount      Decimal @default(0) @db.Decimal(15, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String     @id @default(cuid())
  companyId     String
  invoiceId     String?
  expenseId     String?
  amount        Decimal       @db.Decimal(15, 2)
  currency      String     @default("USD")
  paymentDate   DateTime   @default(now())
  paymentMethod String     @default("bank_transfer")
  reference     String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice       Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expense       ExpenseTransaction? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]
  /// The instrument that produced this payment, when one did. Prisma-side only.
  chequeInstruments ChequeInstrument[]

  @@index([companyId])
  @@index([invoiceId])
  @@index([expenseId])
  /// Serves both the payments list (ordered by paymentDate desc within a
  /// company) and the calendar's month window.
  @@index([companyId, paymentDate])
}

model IncomeTransaction {
  id                  String    @id @default(cuid())
  companyId           String
  customerId          String?
  description         String
  category            String?
  amount              Decimal   @db.Decimal(15, 2)
  currency            String    @default("USD")
  date                DateTime  @default(now())
  expectedPaymentDate DateTime?
  status              String    @default("EXPECTED")
  notes               String?
  attachmentPath      String?
  attachmentPublic    Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  bankTransactions    BankTransaction[]

  @@index([companyId])
  @@index([status])
  /// The income list orders by date desc within a company.
  @@index([companyId, date])
}

model ExpenseTransaction {
  id               String    @id @default(cuid())
  companyId        String
  vendorId         String?
  description      String
  category         String?
  amount           Decimal   @db.Decimal(15, 2)
  /// Input VAT (indirilecek KDV) included in `amount`. Both nullable: an
  /// expense recorded without them simply does not appear in the VAT report.
  taxRate          Decimal?  @db.Decimal(7, 4)
  taxAmount        Decimal?  @db.Decimal(15, 2)
  currency         String    @default("USD")
  date             DateTime  @default(now())
  dueDate          DateTime?
  status           String    @default("UNPAID")
  notes            String?
  attachmentPath   String?
  attachmentPublic Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor           Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  payments         Payment[]
  bankTransactions BankTransaction[]
  /// Cheques and notes issued to settle this expense. Prisma-side only.
  chequeInstruments ChequeInstrument[]

  @@index([companyId])
  @@index([status])
  /// The expenses list orders by date desc within a company.
  @@index([companyId, date])
  /// The calendar's month window filters unpaid expenses by due date.
  @@index([companyId, dueDate])
}

model Category {
  id        String   @id @default(cuid())
  companyId String
  name      String
  type      String   @default("expense")
  color     String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name, type])
  @@index([companyId])
}

model Attachment {
  id               String   @id @default(cuid())
  companyId        String
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  fileName         String
  contentType      String
  size             Int?
  createdAt        DateTime @default(now())
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Calendar entries a user creates by hand: meetings, reminders, and notes
/// attached to a customer or invoice.
///
/// Deliberately NOT a mirror of financial records. Invoice due dates, expense
/// due dates and payment dates are already derived at query time from the
/// Invoice / ExpenseTransaction / Payment tables, and duplicating them here
/// would create two sources of truth that drift the moment a due date changes
/// — plus exactly the orphan rows that would need cleaning up after a delete.
/// `source` records the distinction so a future job could store derived events
/// if that decision is ever revisited.
model Event {
  id          String    @id @default(cuid())
  companyId   String
  /// Who created it. Nullable so removing a user does not delete the company's
  /// calendar; the entry survives its author.
  createdById String?

  title       String
  description String?

  /// Start is required — an event without a time cannot be placed on a calendar.
  startAt     DateTime
  /// End is optional: a reminder is a point in time, a meeting is a range.
  endAt       DateTime?
  allDay      Boolean   @default(false)

  /// PAYMENT_DUE | PAYMENT_RECEIVED | INVOICE_CREATED | INVOICE_DUE |
  /// EXPENSE_DUE | INCOME | MEETING | REMINDER | OTHER
  /// Stored as a string to match how Invoice.status and the transaction
  /// statuses are already modelled in this schema.
  type        String    @default("OTHER")
  /// Free-form lifecycle marker, e.g. PLANNED | DONE | CANCELLED.
  status      String?
  /// MANUAL for user-created entries. Reserved for a future derived-event job.
  source      String    @default("MANUAL")

  /// Optional links. Both use SetNull rather than Cascade: deleting an invoice
  /// should not silently remove a meeting a user scheduled about it. Title and
  /// description live on the event itself, so it stays readable once unlinked.
  customerId  String?
  invoiceId   String?

  /// Money shown on the entry, when it represents one. Same precision as every
  /// other monetary column. Currency is stored alongside it and never mixed —
  /// no conversion is implied.
  amount      Decimal?  @db.Decimal(15, 2)
  currency    String?

  reminderAt  DateTime?
  /// Set when the reminder email went out, so the daily cron sends it once.
  reminderSentAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// The calendar's only hot query: one company's events inside a date window.
  @@index([companyId, startAt])
  /// Filtering a month view by event type.
  @@index([companyId, type])
  /// "Show everything scheduled about this invoice / customer."
  @@index([invoiceId])
  @@index([customerId])
  /// The daily reminder sweep looks events up by reminder time alone.
  @@index([reminderAt])
}


/// The company's paid plan, mirrored from Polar.
///
/// Deliberately separate from `Payment`, which records money this business
/// collects from *its own* customers. A subscription charge is money flowing
/// the other way — to us — and writing it into Payment, IncomeTransaction or
/// ExpenseTransaction would corrupt the user's own bookkeeping: dashboard
/// revenue, reports and the calendar all read those tables.
///
/// Billing history and payment methods are not mirrored here at all; they stay
/// in Polar's customer portal, which avoids duplicate records and keeps card
/// data outside this system entirely.
///
/// There is no `Plan` or `Price` table. Two plans and four prices are mapped in
/// lib/billing/plans.ts against the ids configured in the environment, so Polar
/// remains the single source of truth for pricing.
model Subscription {
  id                  String    @id @default(cuid())

  /// One subscription per company. The Free plan is the absence of this row,
  /// not a row with a "free" status: that keeps every row traceable to a real
  /// Polar subscription and avoids a write path the webhook does not own.
  companyId           String    @unique

  /// Polar's identifier. Unique so a redelivered webhook upserts the same row
  /// instead of creating a second one.
  polarSubscriptionId String    @unique
  polarCustomerId     String
  polarProductId      String
  polarPriceId        String

  /// 'pro' | 'business' — resolved from polarPriceId, never sent by a client.
  plan                String
  /// See lib/billing/access.ts for the statuses and what each one grants.
  status              String
  /// 'month' | 'year'
  interval            String

  currency            String
  /// Decimal, matching every other money column in this schema. A float here
  /// would be the one place in the application where money is approximate.
  amount              Decimal   @db.Decimal(15, 2)

  currentPeriodStart  DateTime
  /// What the UI shows as the renewal date, and what access is measured against.
  currentPeriodEnd    DateTime

  cancelAtPeriodEnd   Boolean   @default(false)
  canceledAt          DateTime?
  trialEndsAt         DateTime?

  /// Timestamp of the last Polar event applied to this row. Webhooks can arrive
  /// out of order, so an event older than this is ignored rather than allowed
  /// to overwrite a newer state.
  lastEventAt         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company             Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

/// An administrative action, recorded for review.
///
/// Deliberately standalone: no foreign keys to User or Company. An audit trail
/// that cascades away when its subject is deleted is not an audit trail — the
/// deletion is exactly the event worth keeping. The ids are stored as plain
/// strings and the actor's address is denormalised, so the record still reads
/// after the account it describes is gone.
///
/// What must never be written here: passwords, hashes, access tokens, webhook
/// secrets, session tokens, card details. `redactMetadata` in lib/admin/audit.ts
/// strips those before anything reaches this table.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())

  /// Who acted. Null when the actor's account has since been removed.
  actorUserId String?
  /// Denormalised so the entry survives the account being deleted.
  actorEmail  String

  /// What happened, e.g. "user.viewed", "company.viewed", "admin.signed_in".
  action     String
  /// What it happened to, e.g. "user", "company", "invoice".
  entityType String?
  entityId   String?
  /// The company the action concerned, when it concerned one.
  companyId  String?

  /// Extra context, already redacted. Never raw request bodies.
  metadata   Json?

  /// Request origin, kept for security review. Truncated on write.
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
  @@index([companyId])
  @@index([entityType, entityId])
}

/// A pending password reset.
///
/// The token is never stored. Only its SHA-256 hash is, so a leaked database
/// dump does not hand anyone a working reset link — the same reason passwords
/// are hashed. The plaintext exists once, in the email, and nowhere else.
///
/// Rows are kept after use rather than deleted: `usedAt` is what makes a link
/// single-use, and a deleted row would simply look like a token that never
/// existed, which is harder to reason about during an incident.
model PasswordResetToken {
  id        String    @id @default(cuid())
  /// SHA-256 of the token that was emailed. Unique so a lookup is exact.
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  /// Set the moment the token is spent. A second attempt finds it non-null.
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A pending email verification.
///
/// Same shape and single-use discipline as PasswordResetToken: only the SHA-256
/// hash of the emailed token is stored, `usedAt` makes it single-use, and a
/// 24-hour `expiresAt` bounds it. Verification is not required to sign in — it
/// only sets User.emailVerified — so a lapsed token locks nobody out.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================================
// Banking & Reconciliation
// =============================================================================

/// A bank account belonging to one company.
///
/// Provider-agnostic on purpose. Today every account is `provider = "manual"`
/// and its transactions arrive by CSV import or by hand; the columns below are
/// exactly what a Plaid / Wise / Open Banking connector would need later
/// (`provider`, `providerAccountId`, `lastSyncedAt`), so adding one is a new
/// module under lib/banking/providers rather than a schema change.
///
/// `lastBalance` is what the *bank* last reported, not a figure this
/// application derives. Deriving a balance from imported lines would be wrong
/// the moment an import is partial, so the number is only ever written from a
/// statement or entered by the user, and `lastBalanceAt` records when.
model BankAccount {
  id                String   @id @default(cuid())
  companyId         String

  bankName          String
  accountName       String
  /// Last four digits or a masked form. Never the full number: this table is
  /// read by list endpoints and there is no feature that needs it in full.
  accountNumber     String?
  iban              String?

  /// One of lib/currencies.ts. An account holds a single currency, which is
  /// what makes the reconciliation currency check meaningful.
  currency          String   @default("USD")

  /// Registry key in lib/banking/providers.ts. "manual" is the only one that
  /// ships today.
  provider          String   @default("manual")
  /// The provider's own identifier for this account. Null for manual accounts;
  /// unique per company+provider so a re-connect updates rather than duplicates.
  providerAccountId String?

  lastBalance       Decimal? @db.Decimal(15, 2)
  lastBalanceAt     DateTime?
  /// When transactions were last pulled or imported.
  lastSyncedAt      DateTime?

  /// Closed accounts are hidden from pickers but keep their history.
  isActive          Boolean  @default(true)
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions      BankTransaction[]

  @@unique([companyId, provider, providerAccountId])
  @@index([companyId])
}

/// One line on a bank statement.
///
/// Amounts are stored positive with an explicit `direction`, rather than signed.
/// A signed column invites the sign to be dropped somewhere in the UI and read
/// as its opposite; a direction cannot be silently lost, and it is also what
/// every provider's API and every CSV export actually gives us.
///
/// The match target is four nullable foreign keys rather than a polymorphic
/// (type, id) pair, mirroring how Payment already links to either an Invoice or
/// an ExpenseTransaction. The reason is referential integrity: `ON DELETE SET
/// NULL` means deleting an invoice cannot leave a bank line claiming to be
/// matched to a record that no longer exists. `status` records intent, and the
/// effective state is derived from status *plus* the links — see
/// lib/banking/reconciliation.ts.
model BankTransaction {
  id             String   @id @default(cuid())
  companyId      String
  bankAccountId  String

  /// A calendar date, stored at UTC midnight like every other financial date
  /// in this schema. See lib/calendar-date.ts.
  date           DateTime
  description    String
  /// Always positive; `direction` carries the sign.
  amount         Decimal  @db.Decimal(15, 2)
  currency       String   @default("USD")
  /// "CREDIT" (money in) or "DEBIT" (money out).
  direction      String
  /// Running account balance after this line, when the statement supplies one.
  balance        Decimal? @db.Decimal(15, 2)
  reference      String?

  /// The provider's or the import file's stable identifier for this line.
  /// Unique per account so re-importing the same statement updates nothing
  /// rather than duplicating every row.
  externalId     String?

  /// "UNMATCHED" | "MATCHED" | "IGNORED".
  status         String   @default("UNMATCHED")

  matchedInvoiceId String?
  matchedPaymentId String?
  matchedIncomeId  String?
  matchedExpenseId String?
  matchedAt        DateTime?
  /// 0-100 from lib/banking/matching.ts when the match was made automatically;
  /// null when a person chose it.
  matchConfidence  Int?

  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount    BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedInvoice Invoice?            @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  matchedPayment Payment?            @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedIncome  IncomeTransaction?  @relation(fields: [matchedIncomeId], references: [id], onDelete: SetNull)
  matchedExpense ExpenseTransaction? @relation(fields: [matchedExpenseId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, externalId])
  @@index([companyId])
  /// The reconciliation list: one company's lines, newest first.
  @@index([companyId, date])
  /// The same list filtered to one account.
  @@index([bankAccountId, date])
  /// The dashboard's unreconciled count.
  @@index([companyId, status])
}


/// A cheque or promissory note — çek or senet.
///
/// A post-dated cheque is a primary settlement instrument for a Turkish small
/// business: a customer settles a six-week-old invoice with a cheque dated six
/// weeks out, and the supplier is paid the same way. Until it clears, that
/// cheque is neither cash nor a plain receivable. It is a dated promise with a
/// lifecycle of its own, and the business needs to know what is in the drawer,
/// what falls due next week, and what bounced.
///
/// ## Why this is not a Payment
///
/// `Payment` records money that has moved. A cheque received is a promise, and
/// writing one as a Payment would mark the invoice paid and tell the user they
/// have been paid when they have not — the exact defect closed in
/// `fix(invoices): stop an invoice being marked paid without a payment`.
///
/// So an instrument holds no money on its own. When it CLEARS, the API creates
/// a real Payment through the ordinary route and lets
/// `recalculateInvoicePaymentState` derive the invoice's status from it. Every
/// figure in the product therefore continues to come from Payment rows alone,
/// and nothing here writes a status onto an invoice.
///
/// ## Deletion
///
/// `companyId` cascades, like every other model: a deleted company takes its
/// records with it.
///
/// Every other relation is SetNull, following `Event`. An instrument is
/// financial evidence — a cheque somebody handed over, with a bank, a number
/// and a due date — and deleting the customer record it was linked to must not
/// erase the fact that it exists. The instrument survives with a null link and
/// its own `drawerName` still readable, which is what a business chasing a
/// bounced cheque actually needs. (The customer route already refuses to delete
/// a customer holding invoices, so this is the second line, not the first.)
///
/// ## Endorsement
///
/// Deliberately not modelled in this version. Passing a received cheque on to a
/// supplier — ciro — is real and common, but it turns an instrument into
/// something that moves between accounts and roughly doubles the state machine.
/// When it is built it attaches here: an `endorsedToVendorId` alongside
/// `vendorId`, an `endorsedFromId` self-relation for the chain, and an
/// ENDORSED status between PORTFOLIO and the terminal states. Nothing in this
/// model forecloses that.
model ChequeInstrument {
  id            String   @id @default(cuid())
  companyId     String

  /// 'RECEIVED' (from a customer) or 'ISSUED' (to a supplier). See
  /// lib/cheque-status.ts — the two have different lifecycles.
  direction     String
  /// 'CHEQUE' or 'PROMISSORY_NOTE'. A senet is a different instrument in law
  /// but the same shape here: an amount, a due date and a lifecycle.
  instrument    String   @default("CHEQUE")

  amount        Decimal  @db.Decimal(15, 2)
  /// One of lib/currencies.ts, alongside the amount as everywhere else. Totals
  /// are grouped per currency and never summed across them.
  currency      String   @default("USD")

  /// The day the instrument was written or handed over.
  issueDate     DateTime @default(now())
  /// Vade — the day it can be presented. This is the column every query orders
  /// by, because the question is always "what is coming up".
  dueDate       DateTime

  /// Free text, as printed on the instrument. Not a foreign key to BankAccount:
  /// a received cheque is drawn on somebody else's bank, which this business
  /// has no account at.
  bankName      String?
  /// The cheque or note number, as printed.
  chequeNumber  String?
  /// Keşideci — whoever wrote it. Kept as text even when `customerId` is set,
  /// because the drawer is often not the customer.
  drawerName    String?

  /// See lib/cheque-status.ts for the transition table and terminal states.
  status        String   @default("PORTFOLIO")

  /// When it was presented to the bank, and when it cleared or bounced. Kept
  /// because "it bounced" is worth a date of its own.
  presentedAt   DateTime?
  settledAt     DateTime?

  notes         String?

  /// Who gave it, or who it was given to. At most one is set: a received
  /// instrument has a customer, an issued one has a vendor.
  customerId    String?
  vendorId      String?

  /// What it settles, if anything. An instrument may be recorded with no
  /// document behind it — a cheque taken on account, before the invoice exists.
  invoiceId     String?
  expenseId     String?

  /// The Payment this instrument produced when it cleared. Null until then,
  /// which is the whole point: no money exists before that moment. Set rather
  /// than derived so clearing twice is visible rather than silently doubling.
  paymentId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor        Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  invoice       Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expense       ExpenseTransaction? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  /// The list, and the "what falls due" totals: one company's instruments in
  /// due-date order. Every screen sorts by vade.
  @@index([companyId, dueDate])
  /// The portfolio and bounced filters, and the dashboard counts.
  @@index([companyId, status])
  /// The calendar's month window, which filters received and issued separately.
  @@index([companyId, direction, dueDate])
  @@index([customerId])
  @@index([vendorId])
  @@index([invoiceId])
  @@index([expenseId])
}

/// A quote (teklif). Same money model as an invoice; turns into one with a
/// click, items copied as they are. Status is a String like Invoice.status:
/// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED.
model Quote {
  id                 String      @id @default(cuid())
  companyId          String
  customerId         String
  quoteNumber        String
  status             String      @default("DRAFT")
  issueDate          DateTime    @default(now())
  validUntil         DateTime
  currency           String      @default("TRY")
  subtotal           Decimal     @default(0) @db.Decimal(15, 2)
  taxTotal           Decimal     @default(0) @db.Decimal(15, 2)
  discountTotal      Decimal     @default(0) @db.Decimal(15, 2)
  total              Decimal     @default(0) @db.Decimal(15, 2)
  notes              String?
  sentAt             DateTime?
  /// Set once, when the quote is turned into an invoice; unique so a quote
  /// can never produce two invoices.
  convertedInvoiceId String?     @unique
  convertedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items              QuoteItem[]
  convertedInvoice   Invoice?    @relation("QuoteConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)

  @@unique([companyId, quoteNumber])
  @@index([companyId])
  @@index([companyId, status])
  @@index([customerId])
  @@index([status, validUntil])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Decimal @default(1) @db.Decimal(15, 4)
  unitPrice   Decimal @default(0) @db.Decimal(15, 2)
  discount    Decimal @default(0) @db.Decimal(15, 2)
  taxRate     Decimal @default(0) @db.Decimal(7, 4)
  taxLabel    String  @default("KDV")
  amount      Decimal @default(0) @db.Decimal(15, 2)
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

/// A recurring invoice template. The daily cron turns a due template into a
/// DRAFT invoice (or a sent one when autoSend is on — off by default).
/// frequency: MONTHLY | QUARTERLY | YEARLY. nextRunDate is a calendar date
/// (UTC midnight); dayOfMonth keeps month-end dates stable (31 → 28 → 31).
model RecurringInvoice {
  id               String                 @id @default(cuid())
  companyId        String
  customerId       String
  name             String?
  frequency        String                 @default("MONTHLY")
  dayOfMonth       Int
  nextRunDate      DateTime
  endDate          DateTime?
  isActive         Boolean                @default(true)
  autoSend         Boolean                @default(false)
  currency         String                 @default("TRY")
  paymentTermsDays Int                    @default(30)
  notes            String?
  lastRunAt        DateTime?
  runCount         Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  company          Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items            RecurringInvoiceItem[]
  invoices         Invoice[]

  @@index([companyId])
  @@index([isActive, nextRunDate])
  @@index([customerId])
}

model RecurringInvoiceItem {
  id                 String           @id @default(cuid())
  recurringInvoiceId String
  description        String
  quantity           Decimal          @default(1) @db.Decimal(15, 4)
  unitPrice          Decimal          @default(0) @db.Decimal(15, 2)
  discount           Decimal          @default(0) @db.Decimal(15, 2)
  taxRate            Decimal          @default(0) @db.Decimal(7, 4)
  taxLabel           String           @default("KDV")
  position           Int              @default(0)
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  @@index([recurringInvoiceId])
}

/// An invitation for an accountant (mali müşavir) to read one company's books.
/// The token itself is never stored, only its SHA-256 hash; an invitation is
/// usable once, for seven days, by an account with the invited email address.
/// Accepting creates a CompanyMember with role "accountant" (read-only).
model AccountantInvite {
  id             String    @id @default(cuid())
  companyId      String
  email          String
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Avc KolayStok — stock only. Every table is company-scoped (companyId).
// ---------------------------------------------------------------------------

/// Per-company KolayStok settings. `staffCode` is the company's own staff
/// sign-in link (/kolaystok/<staffCode>).
model StockSettings {
  id               String    @id @default(cuid())
  companyId        String    @unique
  staffCode        String    @unique
  alertEmails      String[]  @default([])
  senderEmail      String?
  senderDomainId   String?
  senderVerifiedAt DateTime?
  /// One-tap "+" / "−" reasons (quickPlusReason, quickMinusReason) are added
  /// by migration 20261108120000_kolaystok_quick_reasons and read/written
  /// with plain SQL (lib/stock/settings.ts), so nothing breaks before that
  /// migration is applied. Add them here once it is.
  /// Until then do NOT run `prisma migrate dev` or `prisma db push`: they would
  /// see the columns as extra and drop them. `prisma migrate deploy` is safe.
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Warehouse staff: a name and a 4-digit PIN (hashed), no account. Role
/// "manager" or "staff". At most five per company (enforced in the API).
model StockStaff {
  id          String    @id @default(cuid())
  companyId   String
  name        String
  pinHash     String
  role        String    @default("staff")
  failedPins  Int       @default(0)
  lockedUntil DateTime?
  isActive    Boolean   @default(true)
  /// Bumped when the PIN, role or active flag changes: ends older sessions.
  sessionVersion Int    @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model StockCategory {
  id        String         @id @default(cuid())
  companyId String
  name      String
  vendorId  String?
  createdAt DateTime       @default(now())
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor    Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  products  StockProduct[]

  @@unique([companyId, name])
}

/// A stocked item. `quantity` is changed only together with a StockMovement.
/// `searchKey` is the Turkish-insensitive name + code used by the search box.
/// `lowAlertAt` is set when the low-stock alert went out and cleared when the
/// product climbs back above its minimum, so each dip alerts once.
model StockProduct {
  id            String          @id @default(cuid())
  companyId     String
  code          String
  name          String
  searchKey     String          @default("")
  categoryId    String?
  size          String?
  material      String?
  unit          String          @default("adet")
  purchasePrice Decimal?        @db.Decimal(15, 2)
  salePrice     Decimal?        @db.Decimal(15, 2)
  quantity      Decimal         @default(0) @db.Decimal(15, 3)
  minStock      Decimal         @default(50) @db.Decimal(15, 3)
  targetStock   Decimal?        @db.Decimal(15, 3)
  shelf         String?
  photoKey      String?
  vendorId      String?
  notes         String?
  lowAlertAt    DateTime?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      StockCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  movements     StockMovement[]
  countLines    StockCountLine[]

  @@unique([companyId, code])
  @@index([companyId, searchKey])
  @@index([companyId, categoryId])
}

/// Every stock change: who, when, how much, why. Undo writes a reverse
/// movement (`undoOfId`) and stamps the original (`undoneAt`).
model StockMovement {
  id            String       @id @default(cuid())
  companyId     String
  productId     String
  delta         Decimal      @db.Decimal(15, 3)
  quantityAfter Decimal      @db.Decimal(15, 3)
  reason        String
  note          String?
  actorUserId   String?
  actorStaffId  String?
  actorName     String
  countId       String?
  resetId       String?
  undoOfId      String?
  undoneAt      DateTime?
  createdAt     DateTime     @default(now())
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([productId, createdAt])
}

/// A stock count (sayım), resumable: `position` is where it was left.
model StockCount {
  id         String           @id @default(cuid())
  companyId  String
  categoryId String?
  status     String           @default("open")
  position   Int              @default(0)
  startedBy  String
  createdAt  DateTime         @default(now())
  finishedAt DateTime?
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines      StockCountLine[]

  @@index([companyId, status])
}

model StockCountLine {
  id        String       @id @default(cuid())
  countId   String
  productId String
  counted   Decimal      @db.Decimal(15, 3)
  createdAt DateTime     @default(now())
  count     StockCount   @relation(fields: [countId], references: [id], onDelete: Cascade)
  product   StockProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
}

/// "Reset all stock": the Excel backup taken first, and a 24-hour undo.
model StockReset {
  id        String    @id @default(cuid())
  companyId String
  byUserId  String
  backupKey String?
  createdAt DateTime  @default(now())
  undoneAt  DateTime?
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

/// A Telegram chat that receives this company's stock alerts.
model StockTelegramChat {
  id        String   @id @default(cuid())
  companyId String
  chatId    String
  name      String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, chatId])
}

/// One-time, expiring code behind a "Connect Telegram" link
/// (t.me/<bot>?start=<code>). Only the hash is stored; the bot learns the
/// company and the person from it.
model StockTelegramCode {
  id        String    @id @default(cuid())
  companyId String
  codeHash  String    @unique
  label     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// Daily Excel backup of the stock, kept 30 days in S3.
model StockBackup {
  id        String   @id @default(cuid())
  companyId String
  day       DateTime @db.Date
  s3Key     String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, day])
}
